# AgentFlow Enterprise Frontend Environment Variables

# Backend API Gateway Base URL (FastAPI)
VITE_API_BASE_URL=http://localhost:8000

# Amazon Cognito Authentication Config (USER_PASSWORD_AUTH flow)
VITE_COGNITO_USER_POOL_ID=us-east-1_examplePoolId
VITE_COGNITO_CLIENT_ID=exampleClientId1234567890

# Optional AWS Region (defaults to us-east-1)
VITE_COGNITO_REGION=us-east-1
