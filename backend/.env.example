# Cloud Switch (true on EC2/production, false for local dev)
USE_AWS=false

# AWS Cloud Infrastructure (Set in .env or environment)
AWS_REGION=us-east-1
DYNAMO_SESSIONS=agent_sessions
DYNAMO_AUDIT=agent_audit
S3_BUCKET=agent-platform-mvp-<your-account-id>
SQS_URL=https://sqs.us-east-1.amazonaws.com/<your-account-id>/agent_tasks.fifo
SNS_ARN=arn:aws:sns:us-east-1:<your-account-id>:agent_approvals

# AWS RDS Relational Database (PostgreSQL)
USE_RDS=false
RDS_HOST=your-rds-instance.xxxxxx.us-east-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DB_NAME=agentflow
RDS_USER=postgres
RDS_PASSWORD=your-secure-rds-password
RDS_SSL_MODE=prefer
# DATABASE_URL=postgresql://postgres:password@your-rds-instance.xxxxxx.us-east-1.rds.amazonaws.com:5432/agentflow

# LLM Provider
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Local Dev Fallbacks
FAISS_INDEX_PATH=data/faiss_index
FAISS_METADATA_PATH=data/faiss_metadata.json
SQLITE_AUDIT_DB=data/audit.db

# Auth
AUTH_MODE=local
JWT_SECRET=dev-secret-change-me
COGNITO_POOL_ID=
COGNITO_CLIENT_ID=

# StreamSphere chat service (backend-to-backend; never put these in VITE_* vars)
# STREAMING_API_KEY is the streaming app's AGENT_API_KEY (at least 32 characters).
# STREAMING_TOOL_API_KEY is its existing TOOL_API_KEY (a separate secret).
STREAMING_TENANT_ID=streamsphere-prod-01
STREAMING_API_KEY=
STREAMING_BASE_URL=http://localhost:3001
STREAMING_TOOL_API_KEY=
STREAMING_TOOL_TIMEOUT=15
